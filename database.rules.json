{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null",
        "players": {
          "$uid": {
            ".validate": "newData.hasChildren(['uid','name','avatar']) && newData.child('uid').val() == $uid"
          }
        },
        "private": {
          "$uid": {
            ".read": "auth != null && (auth.uid == $uid || root.child('rooms').child($code).child('hostId').val() == auth.uid)",
            ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() == auth.uid"
          }
        }
      }
    }
  }
}