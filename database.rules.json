{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": "auth != null && ((!data.exists() && newData.child('hostId').val() == auth.uid) || data.child('hostId').val() == auth.uid)",
        "hostId": {
          ".read": "auth != null"
        },
        "status": {
          ".read": "auth != null"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('status').val() == 'lobby'",
            ".validate": "newData.hasChildren(['uid','name','avatar']) && newData.child('uid').val() == $uid"
          }
        },
        "game": {
          "tf": {
            "votes": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('players').child($uid).exists()",
                ".validate": "!newData.exists() || newData.val() == 'vrai' || newData.val() == 'faux'"
              }
            }
          },
          "duel": {
            "ballots": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('game').child('roles').child($uid).val() == 'arbitre'",
                ".validate": "!newData.exists() || newData.val() == 'pour' || newData.val() == 'contre'"
              }
            }
          },
          "imp": {
            "votes": {
              "$uid": {
                ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('players').child($uid).exists()",
                ".validate": "!newData.exists() || (newData.isString() && newData.val() != $uid && root.child('rooms').child($code).child('players').child(newData.val()).exists())"
              }
            }
          }
        }
      }
    },
    "playerSecrets": {
      "$code": {
        ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() == auth.uid",
        "$uid": {
          ".read": "auth != null && auth.uid == $uid && root.child('rooms').child($code).child('players').child($uid).exists()",
          ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() == auth.uid",
          ".validate": "!newData.exists() || newData.hasChildren(['role','subject'])"
        }
      }
    },
    "hostSecrets": {
      "$code": {
        ".read": "auth != null && root.child('rooms').child($code).child('hostId').val() == auth.uid",
        ".write": "auth != null && root.child('rooms').child($code).child('hostId').val() == auth.uid",
        ".validate": "!newData.exists() || newData.hasChildren(['impostorUid','subject','decoy'])"
      }
    }
  }
}
